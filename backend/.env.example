# Database
DATABASE_URL=sqlite:./data/transfers.db?mode=rwc

# Security — CHANGE THIS in production (32+ random characters)
HMAC_SECRET=change-me-to-a-secure-random-string

# Transfer settings
TRANSFER_EXPIRY_MINUTES=15

# Solana RPC
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Logging
RUST_LOG=info
